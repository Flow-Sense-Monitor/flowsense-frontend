# Copie para .env (desenvolvimento) e ajuste. Variáveis VITE_* entram no JavaScript do navegador:
# NÃO coloque aqui nada que precise ser secreto de verdade.

# Endereço do backend. Deixe vazio para usar o mesmo endereço do site
# (o nginx do Docker e o "npm run dev" repassam /api ao backend).
VITE_API_URL=

# Mesma chave de FLOWSENSE_API_KEY do backend; enviada no cabeçalho X-API-Key dos comandos.
VITE_API_KEY=troque-por-uma-chave-longa

# Só para "npm run dev": para onde o Vite repassa /api.
VITE_PROXY_BACKEND=http://localhost:8080
